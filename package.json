{
  "name": "opencode-jello",
  "version": "0.1.3",
  "description": "Jello: an OpenCode Desktop GUI plugin.",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-desktop"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "vite build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.1",
    "@pierre/diffs": "^1.6.2",
    "typescript": "^5.9.0",
    "typescript-language-server": "^6.0.2",
    "vscode-jsonrpc": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}